# Optional: Set custom host URL. If not set, will auto-detect from window.location
# Examples:
#   REACT_APP_HOST=http://localhost:3000
#   REACT_APP_HOST=http://example.com
#   REACT_APP_HOST=https://api.example.com:8080
# REACT_APP_HOST=

# Dynamsoft DWT Product Key (Required for production)
REACT_APP_DWT_PRODUCT_

# Optional: Upload target URL. If not set, will use host + /api/upload
# REACT_APP_UPLOAD_URL=https://your-upload-server.com/upload