{
  "name": "dynamic-web-twain-mfe",
  "version": "1.0.0",
  "description": "DynamicWebTWAIN as a Micro Frontend — standalone or plug-and-play component",
  "main": "dist/dwt-mfe.js",
  "module": "dist/dwt-mfe.js",
  "exports": {
    ".": {
      "require": "./dist/dwt-mfe.js",
      "import": "./dist/dwt-mfe.js",
      "default": "./dist/dwt-mfe.js"
    }
  },
  "scripts": {
    "start": "webpack serve --config webpack.dev.ts",
    "build": "webpack --config webpack.prod.ts",
    "copy-dwt": "ncp node_modules/dwt/dist public/Resources",
    "preview:prod": "npm run build && serve dist",
    "prebuild": "npm run copy-dwt",
    "prestart": "npm run copy-dwt",
    "type-check": "tsc --noEmit",
    "publish:local": "npm run build && yalc publish",
    "push:local": "npm run build && yalc push",
    "docker:build": "docker build -t web-twain-mfe .",
    "docker:run": "docker run -p 8080:80 web-twain-mfe"
  },
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS",
      "moduleResolution": "node"
    }
  },
  "dependencies": {
    "dwt": "19.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-helmet": "^6.1.0",
    "rxjs": "7.8.1",
    "yalc": "^1.0.0-pre.53"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@types/node": "^20.14.8",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "@types/webpack": "^5.28.5",
    "@types/webpack-dev-server": "^4.7.2",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.0",
    "mini-css-extract-plugin": "^2.9.0",
    "ncp": "^2.0.0",
    "serve": "^14.2.6",
    "style-loader": "^4.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "url-loader": "^4.1.1",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
