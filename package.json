{
  "name": "dynamic-web-twain-mfe",
  "version": "1.0.0",
  "description": "DynamicWebTWAIN as a Micro Frontend — standalone or plug-and-play component",
  "main": "dist/dwt-mfe.js",
  "module": "dist/dwt-mfe.js",
  "exports": {
    ".": {
      "require": "./dist/dwt-mfe.js",
      "import": "./dist/dwt-mfe.js",
      "default": "./dist/dwt-mfe.js"
    }
  },
  "scripts": {
    "clean": "rmdir /s node_modules dist coverage build && del /f ./package-lock.json && npm cache clean --force",
    "clean:resources": "node scripts/clean-resources.js",
    "start": "webpack serve --config webpack.dev.ts",
    "build": "webpack --config webpack.prod.ts",
    "copy-dwt": "node scripts/copy-dwt.js",
    "copy-dwt:verbose": "node scripts/copy-dwt.js --verbose",
    "copy-dwt:force": "npm run clean:resources && npm run copy-dwt",
    "preview:prod": "npm run build && serve dist",
    "prebuild": "npm run copy-dwt",
    "prestart": "npm run copy-dwt",
    "type-check": "tsc --noEmit",
    "publish:local": "npm run build && yalc publish",
    "push:local": "npm run build && yalc push",
    "docker:build": "docker build -t web-twain-mfe .",
    "docker:run": "docker run -p 3000:80 web-twain-mfe"
  },
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS",
      "moduleResolution": "node10",
      "ignoreDeprecations": "6.0"
    }
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "dwt": "19.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-helmet": "6.1.0",
    "rxjs": "7.8.1",
    "yalc": "1.0.0-pre.53"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/preset-env": "8.0.2",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/webpack": "5.28.5",
    "@types/webpack-dev-server": "4.7.2",
    "babel-loader": "10.1.1",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.2",
    "file-loader": "6.2.0",
    "html-webpack-plugin": "5.6.6",
    "mini-css-extract-plugin": "2.10.0",
    "ncp": "2.0.0",
    "serve": "14.2.6",
    "style-loader": "4.0.0",
    "ts-node": "10.9.2",
    "typescript": "6.0.2",
    "url-loader": "4.1.1",
    "webpack": "5.104.1",
    "webpack-cli": "7.2.1",
    "webpack-dev-server": "6.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
